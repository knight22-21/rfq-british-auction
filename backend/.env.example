# SQLite by default; point this at PostgreSQL to move off the demo database.
DATABASE_URL=sqlite:///./auction.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seed a few realistic auctions on first boot. Set to 0 for an empty database.
SEED_DEMO_DATA=1
SQL_ECHO=0
